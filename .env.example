GOOGLE_API_KEY=
OPENAI_API_KEY=
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
TAVILY_API_KEY=

# LangSmith tracing (https://smith.langchain.com → Settings → API Keys). 끄려면 LANGSMITH_TRACING=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=make-agents
# EU 리전이면 https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 이력서·경력기술서 원문이 trace에 남는 게 부담이면 true (입력·출력이 trace에서 가려져 디버깅 가치도 줄어든다)
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
